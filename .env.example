# Скопируйте в .env и заполните. .env не коммитится.
# Токен бота из BotFather. Никогда не используйте реальный токен во frontend-коде.
TELEGRAM_BOT_TOKEN=123456789:replace-with-your-botfather-token

# Необязательно: chat_id разработчика, где будет обновляться сообщение с кнопкой.
# TELEGRAM_CHAT_ID=123456789

# Необязательно: закреплять сообщение-кнопку (true по умолчанию).
TELEGRAM_PIN_MESSAGE=true

# Необязательно: провайдер туннеля cloudflared или ngrok (cloudflared по умолчанию).
TUNNEL_PROVIDER=cloudflared

# Необязательно: использовать готовый публичный URL и не запускать туннель.
# TELEGRAM_WEBAPP_URL=https://example.trycloudflare.com

# Необязательно: порт Vite dev server.
DEV_PORT=5173

# Необязательно: адреса edge Cloudflare в формате ip:port через запятую. Нужны, когда
# SRV-записи argotunnel.com не резолвятся (VPN, фильтрация DNS). Иначе подбираются автоматически.
# CLOUDFLARED_EDGE=198.41.192.47:7844,198.41.200.13:7844

# Необязательно: локальный IP для исходящих соединений cloudflared. Помогает, когда VPN
# ломает TLS-хендшейк до edge. Иначе выбирается автоматически (отключить: CLOUDFLARED_NO_BIND=true).
# CLOUDFLARED_BIND_ADDRESS=192.168.1.66
